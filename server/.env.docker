# Docker environment for HelpGrid server
# SQLite DB stored in the mounted volume
DATABASE_URL="file:/app/prisma/prod.db"

# Change this in production!
JWT_SECRET="helpgrid_prod_jwt_secret_change_me_in_production"

PORT=5000

# Frontend URL - Nginx serves on port 80
FRONTEND_URL="http://localhost"

NODE_ENV="production"

AI_PROVIDER="heuristic-llm"
